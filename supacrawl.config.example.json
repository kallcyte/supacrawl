{
  "sitemaps": ["https://example.com/sitemap.xml"],
  "crawl": {
    "delayMs": 2000,
    "maxConcurrency": 2,
    "timeoutMs": 30000,
    "userAgent": "supacrawl/0.1 (+https://github.com/yourname/supacrawl)",
    "respectRobotsTxt": true,
    "maxUrls": 999999,
    "retryOnTransientError": true,
    "maxRetries": 2,
    "maxBodyBytes": 262144,
    "maxGlobalConcurrency": 32
  },
  "checks": {
    "ssl": {
      "enabled": true,
      "warnDays": 30
    },
    "contentDiff": true,
    "responseTime": {
      "warnMs": 3000
    }
  },
  "schedule": "0 */6 * * *"
}
